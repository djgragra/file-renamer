{
  "name": "file-renamer",
  "version": "26.10.1",
  "description": "Batch renamer for audio and video files with placeholder patterns, mandatory preview and undo",
  "main": "main.js",
  "type": "module",
  "author": "Graziano Melzi <hello@onairgarage.com> (https://onairgarage.com)",
  "homepage": "https://onairgarage.com/tools/file-renamer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djgragra/file-renamer.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test dev/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.onairgarage.filerenamer",
    "productName": "File Renamer",
    "publish": null,
    "files": [
      "main.js",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "File-Renamer-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/linux-icons",
      "category": "Utility",
      "artifactName": "File-Renamer-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "File-Renamer-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "shortcutName": "File Renamer"
    }
  }
}
